# CI 専用の非シークレット環境変数（標準CI が起動時に GITHUB_ENV へ読み込む）。
# 本番の値はここに書かない。デプロイ基盤のシークレットが正本。
#
# E2E ジョブは `pnpm run db:migrate` を実行するが、CI には Turso の接続情報が無い。
# drizzle-kit の turso ダイアレクトは libSQL のローカルファイル URL（file:）を受け付けるため、
# CI ではランナー内の一時 SQLite ファイルへマイグレーションして E2E を自己完結させる。
# TURSO_AUTH_TOKEN はローカルファイル接続では使われないが、lib/env.ts の
# isTursoConfigured が両方の変数を要求するためプレースホルダを置く（実在の資格情報ではない）。
TURSO_DATABASE_URL=file:ci-e2e.db
TURSO_AUTH_TOKEN=ci-local-sqlite-no-auth
